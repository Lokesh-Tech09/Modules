# ==============================================================================
# Environment Configuration Template
# Goa Hackathon - Face Identification & Blockchain Verification
# ==============================================================================

# Module 3: Blockchain Provider Configuration
# Options: mock | sepolia | ganache | evm
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=sepolia-testnet

# RPC endpoint (required if BLOCKCHAIN_PROVIDER is sepolia, ganache, or evm)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org

# Smart contract address for VerificationAnchor (required for on-chain anchoring)
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key / Wallet secret reference (NEVER commit actual private keys!)
# In production, set WALLET_PRIVATE_KEY in your local environment, not in source code.
BLOCKCHAIN_PRIVATE_KEY_ENV_VAR=WALLET_PRIVATE_KEY

# Rate limiting & Cost Guard
MAX_WRITES_PER_MINUTE=10

# Off-chain Storage Path (SQLite database)
OFFCHAIN_STORE_PATH=member3_blockchain/offchain_store.db
