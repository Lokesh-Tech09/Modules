# VeriFace — Environment Configuration
# =====================================
# Copy this file to .env and fill in real values for production/testnet use.
# NEVER commit .env or private keys to git.

# ==============================================================================
# Module 3: Blockchain Provider Configuration
# ==============================================================================
# Options: mock | sepolia | ganache | evm
#
# mock     → In-memory simulation (MockChainClient). No credentials needed.
#            Default for local development and demo.
# sepolia  → Real Ethereum Sepolia testnet via JSON-RPC. Requires RPC URL + wallet key.
# ganache  → Local Ganache blockchain. Requires running Ganache instance.
# evm      → Generic EVM-compatible chain.
BLOCKCHAIN_PROVIDER=mock

# Network identifier (displayed in output, does not affect mock mode)
BLOCKCHAIN_NETWORK=sepolia-testnet

# RPC endpoint — Required when BLOCKCHAIN_PROVIDER=sepolia/ganache/evm
# Example Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Example Infura:  https://sepolia.infura.io/v3/YOUR_KEY
# Example public:  https://rpc.sepolia.org  (rate-limited, not for production)
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org

# Smart contract address (optional — for anchor contract verification)
# Leave empty to use standard data-carrying transactions
BLOCKCHAIN_CONTRACT_ADDRESS=

# Environment variable that holds the wallet private key.
# The actual key must be in WALLET_PRIVATE_KEY (never set it here directly).
BLOCKCHAIN_PRIVATE_KEY_ENV_VAR=WALLET_PRIVATE_KEY

# NEVER put your actual private key in this file or commit it to git.
# Instead, set it in your shell or a secure secrets manager:
#   export WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# WALLET_PRIVATE_KEY=  ← DO NOT UNCOMMENT — set in shell environment only

# Rate limiter — max blockchain writes per minute (cost guard)
MAX_WRITES_PER_MINUTE=10

# Off-chain SQLite store path (relative to project root)
OFFCHAIN_STORE_PATH=member3_blockchain/offchain_store.db

# ==============================================================================
# Search Adapter Configuration
# ==============================================================================
# Leave SERPAPI_KEY empty to use free DuckDuckGo search (default)
# Set to your SerpAPI key to upgrade to Google Search results
SERPAPI_KEY=
